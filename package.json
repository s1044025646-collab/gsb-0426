{
  "name": "dominator-service",
  "version": "1.0.0",
  "description": "Offline dominator / dominance-frontier analysis service (API + CLI)",
  "main": "dist/src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test dist/test/*.test.js",
    "start": "npm run build && node --disable-warning=ExperimentalWarning dist/src/server.js",
    "cli": "node --disable-warning=ExperimentalWarning dist/src/cli.js",
    "demo": "npm run build && node scripts/demo.js"
  },
  "keywords": [],
